{
  "autoUpdatesChannel": "latest",
  "env": {
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "4",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git subtree:*)",
      "Bash(git ls-files:*)",
      "Bash(git add:*)",
      "Bash(git push origin HEAD)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(awk 'NR*)",
      "Bash(awk '{print $*)",
      "Bash(awk -F* '{print $*)",
      "Bash(curl:*)",
      "Bash(mkdir:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npm audit:*)",
      "Bash(npm ls:*)",
      "Bash(ASDF_NODEJS_VERSION=*npm run*)",
      "Bash(ASDF_NODEJS_VERSION=*npm test*)",
      "Bash(ASDF_NODEJS_VERSION=*npm install*)",
      "Bash(ASDF_NODEJS_VERSION=*npm audit*)",
      "Bash(ASDF_NODEJS_VERSION=*npm ls*)",
      "Skill(update-config)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:trino.io)",
      "WebFetch(domain:www.datadoghq.com)",
      "WebFetch(domain:docs.datadoghq.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:www.google.com)",
      "WebFetch(domain:stackoverflow.com)",
      "Bash(pandoc:*)",
      "Bash(links -dump:*)",
      "Bash(unzip:*)",
      "Bash(python3:*)",
      "Bash(xargs ls:*)",
      "Bash(gem search:*)",
      "Bash(gem info:*)",
      "Bash(terraform refresh)",
      "Bash(printenv)"
    ],
    "deny": [
      "Bash(claude mcp *)",
      "Bash(spr:*)",
      "Bash(git spr:*)",
      "Bash(*git spr *)",
      "Bash(sed -i*)",
      "Bash(sed * -i*)",
      "Bash(sed -Ei*)",
      "Bash(sed -ri*)",
      "Bash(sed -ni*)",
      "Bash(sed --in-place*)",
      "Bash(sed * --in-place*)",
      "Bash(perl -*)",
      "Bash(awk *print*>*)",
      "Bash(awk *print*|*)",
      "Bash(awk *system(*)",
      "Bash(awk *getline*)",
      "Bash(awk -f*)",
      "Bash(awk * -f*)",
      "Bash(awk *--file*)",
      "Bash(awk -i*)",
      "Bash(awk * -i*)",
      "mcp__plugin_nr_google-search__web_fetch",
      "mcp__plugin_nr_google-search__raw_http_fetch"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git fetch --all --prune >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Fetching latest git refs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/learning-opportunities-commit-nudge.sh\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/chuck/research/dotclaude/hooks/ntfy-push.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/chuck/research/dotclaude/hooks/cancel-ntfy-pending.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "learning-opportunities@learning-opportunities": true,
    "learning-opportunities-auto@learning-opportunities": false,
    "orient@learning-opportunities": true,
    "learning-goal@learning-goal": true
  },
  "extraKnownMarketplaces": {
    "learning-opportunities": {
      "source": {
        "source": "git",
        "url": "https://github.com/DrCatHicks/learning-opportunities.git"
      }
    },
    "learning-goal": {
      "source": {
        "source": "git",
        "url": "https://github.com/DrCatHicks/learning-goal.git"
      }
    }
  },
  "autoCompactWindow": 400000,
  "skipWebFetchPreflight": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "skipAutoPermissionPrompt": true
}
