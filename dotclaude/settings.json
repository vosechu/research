{
  "env": {
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SCROLL_SPEED": "2"
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git subtree:*)",
      "Bash(git ls-files:*)",
      "Bash(git add:*)",
      "Bash(git push origin HEAD)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(curl:*)",
      "Bash(mkdir:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm install:*)",
      "Bash(npm audit:*)",
      "Bash(npm ls:*)",
      "Bash(ASDF_NODEJS_VERSION=*npm run:*)",
      "Bash(ASDF_NODEJS_VERSION=*npm test:*)",
      "Bash(ASDF_NODEJS_VERSION=*npm install:*)",
      "Bash(ASDF_NODEJS_VERSION=*npm audit:*)",
      "Bash(ASDF_NODEJS_VERSION=*npm ls:*)",
      "Skill(update-config)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:trino.io)"
    ],
    "deny": [
      "Bash(claude mcp *)",
      "Bash(spr:*)",
      "Bash(git spr:*)",
      "Bash(*git spr *)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git fetch --all --prune >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "Fetching latest git refs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/gh-stack-steer.sh\""
          },
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/write-gooder-pr-body.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/learning-opportunities-commit-nudge.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "learning-opportunities@learning-opportunities": true,
    "learning-opportunities-auto@learning-opportunities": true,
    "orient@learning-opportunities": true,
    "learning-goal@learning-goal": true
  },
  "extraKnownMarketplaces": {
    "learning-opportunities": {
      "source": {
        "source": "git",
        "url": "https://github.com/DrCatHicks/learning-opportunities.git"
      }
    },
    "learning-goal": {
      "source": {
        "source": "git",
        "url": "https://github.com/DrCatHicks/learning-goal.git"
      }
    }
  },
  "skipWebFetchPreflight": true,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "skipWorkflowUsageWarning": true,
  "theme": "light",
  "skipAutoPermissionPrompt": true
}
